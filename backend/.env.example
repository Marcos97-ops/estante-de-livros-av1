# Connection string do Postgres (Neon). Inclua "?sslmode=require" no final.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/estante?sslmode=require

# Segredo usado para assinar e validar os tokens JWT.
# Gere um valor aleatório longo, por exemplo: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=2h

# Origem(ns) permitida(s) no CORS, separadas por vírgula.
# Em desenvolvimento local, aponte para onde o frontend está sendo servido.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

PORT=3000
NODE_ENV=development
